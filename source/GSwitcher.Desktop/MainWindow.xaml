<Window x:Class="GSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="GSwitcher"
        Width="360"
        Height="580"
        MinWidth="360"
        MinHeight="580"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#050812"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Grid Background="#050812">
        <wv2:WebView2 x:Name="DashboardView" DefaultBackgroundColor="Transparent" />
    </Grid>
</Window>

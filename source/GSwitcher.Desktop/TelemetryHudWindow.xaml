<Window x:Class="GSwitcher.TelemetryHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="330"
        Height="36"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Focusable="False"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Border CornerRadius="18"
            Background="#CC08090D"
            BorderBrush="#5533E7FF"
            BorderThickness="1"
            Padding="14,6"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#00E5FF" ShadowDepth="0" BlurRadius="16" Opacity="0.35"/>
        </Border.Effect>
        <TextBlock x:Name="HudText"
                   Foreground="#F5F8FF"
                   FontFamily="Consolas, Segoe UI"
                   FontSize="12"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   VerticalAlignment="Center"
                   Text="GSwitcher HUD"/>
    </Border>
</Window>
